include ../platform/config.mk

PROJ_NAME = webrtc
PROJ_VER  = main
PROJ_REL  = 2
GIT_BRANCH = main
GIT_REPO_NAME = webrtc-src
GIT_VER := $(shell cat VERSION)
PKG_NAME  = $(PROJ_NAME)-$(PROJ_VER)-$(GIT_VER)-$(PROJ_REL)-$(HOST_ARCH)-$(FP_FLAG).pkg.tar.xz

PWD := $(shell pwd)
# 完整源码树（git 仓库根，gclient 依赖层已齐全）
SRC_DIR    = $(PWD)/src/webrtc-src
OUT_DIR    = $(SRC_DIR)/out/aarch64
INSTALL_DIR = $(PWD)/install/root

# gn/ninja 已随完整检出提供
GN    = $(SRC_DIR)/buildtools/linux64/gn
NINJA = $(SRC_DIR)/third_party/ninja/ninja

# --------------------------------------------------------------------
# 自定义 GN 工具链：直接使用 ubuild 的 aarch64 GCC
# --------------------------------------------------------------------
define TOOLCHAIN_GN
# Auto-generated by ubuild/webrtc Makefile. Do not edit.

# Reuse Chromium's gcc-compatible toolchain template, which already provides
# the cc/cxx/alink/link tools and all rust_* tools (rlib, macro, bin, ...).
import("//build/toolchain/gcc_toolchain.gni")

gcc_toolchain("aarch64") {
  cc      = "$(CROSS_COMPILE)gcc"
  cxx     = "$(CROSS_COMPILE)g++"
  ld      = "$(CROSS_COMPILE)g++"
  ar      = "$(CROSS_COMPILE)ar"
  nm      = "$(CROSS_COMPILE)nm"
  readelf = "$(CROSS_COMPILE)readelf"

  # Code accepted by clang but rejected by GCC: a method name that matches a
  # type name (p2p/base/port_interface.h) is a hard error under GCC's default
  # -Wchanges-meaning.
  extra_cxxflags = "-Wno-changes-meaning"

  toolchain_args = {
    current_os = "linux"
    current_cpu = "arm64"
    is_clang = false
  }
}

# Host (x64) toolchain used for build-time tools (protoc, code generators,
# proc macros). Uses Chromium's hermetic clang + bundled libc++.
clang_toolchain("host_x64") {
  toolchain_args = {
    current_os = "linux"
    current_cpu = "x64"
    is_clang = true
  }
}
endef
export TOOLCHAIN_GN

# --------------------------------------------------------------------
# GN 参数（out/aarch64/args.gn）
# --------------------------------------------------------------------
define ARGS_GN
# Auto-generated by ubuild/webrtc Makefile. Do not edit.
is_debug = false
is_component_build = false
target_os = "linux"
target_cpu = "arm64"
is_clang = false
custom_toolchain = "//ubuild_toolchain:aarch64"
host_toolchain = "//ubuild_toolchain:host_x64"
use_sysroot = false
use_custom_libcxx = false
use_reclient = false
treat_warnings_as_errors = false
fatal_linker_warnings = false
rtc_include_tests = false
rtc_build_examples = false
rtc_build_tools = false
rtc_use_x11 = false
rtc_use_pipewire = false
rtc_include_pulse_audio = false
rtc_include_internal_audio_device = false
use_glib = false
use_ozone = false
arm_control_flow_integrity = "none"
libyuv_use_sme = false
enable_iterator_debugging = false

rtc_exclude_audio_processing_module = true
rtc_build_libvpx = false
rtc_libvpx_build_vp9 = false
rtc_use_h264 = false
rtc_use_h265 = false
proprietary_codecs = false
rtc_include_opus = false
rtc_build_opus = false
rtc_include_builtin_audio_codecs = true
rtc_use_perfetto = false
rtc_disable_trace_events = true
rtc_enable_protobuf = false
rtc_enable_grpc = false
rtc_video_psnr = false
rtc_disable_metrics = true
rtc_include_dav1d_in_internal_decoder_factory = false
enable_libaom = false
libyuv_disable_jpeg = true
endef
export ARGS_GN

.PHONY: default fetchSrc configure build install demo clean distclean \
        fetchPkg put-pkg push-src crossInstall disFetchPkg disFetchSrc disFetchAll PKG

default: build

fetchSrc:
	@if [ -d src ]; then \
		echo "Error: src directory exists."; \
		exit 1; \
	fi
	git clone -b $(GIT_BRANCH) $(GIT_SRC_URL):$(GIT_MAINTAINER)/$(GIT_REPO_NAME).git src/$(GIT_REPO_NAME)

configure:
	@mkdir -p $(OUT_DIR) $(SRC_DIR)/ubuild_toolchain
	@echo "$$TOOLCHAIN_GN" > $(SRC_DIR)/ubuild_toolchain/BUILD.gn
	@echo "$$ARGS_GN" > $(OUT_DIR)/args.gn
	cd $(SRC_DIR) && $(GN) gen out/aarch64

build:
	cd $(SRC_DIR) && $(NINJA) -C out/aarch64 webrtc

install:
	@rm -rf $(INSTALL_DIR)
	@mkdir -p $(INSTALL_DIR)/usr/lib $(INSTALL_DIR)/usr/lib/webrtc_rlib \
	         $(INSTALL_DIR)/usr/include/webrtc
	cp -a $(OUT_DIR)/obj/libwebrtc.a $(INSTALL_DIR)/usr/lib/
	# Rust rlibs are separate link inputs and are not folded into libwebrtc.a.
	# App link: -Wl,--start-group -lwebrtc <rlib dir>/*.rlib -Wl,--end-group
	find $(OUT_DIR)/obj -name '*.rlib' -exec cp -a {} $(INSTALL_DIR)/usr/lib/webrtc_rlib/ \;
	find $(OUT_DIR)/local_rustc_sysroot/lib/rustlib/aarch64-unknown-linux-gnu/lib \
	     -name '*.rlib' ! -name 'libtest_*' ! -name 'libproc_macro_*' \
	     ! -name 'libgetopts_*' ! -name 'libprofiler_builtins_*' \
	     -exec cp -a {} $(INSTALL_DIR)/usr/lib/webrtc_rlib/ \;
	# Public headers only. Whole-directory cp also pulls in 1000+ .cc sources
	# (already compiled into libwebrtc.a), so extract *.h preserving paths.
	# pc/ and modules/ are required by the external-H264 encoder wrapper
	# (video_track_source.h, CodecSpecificInfo, H264 packetization).
	cd $(SRC_DIR) && find api rtc_base logging pc p2p common_video common_audio \
	    system_wrappers modules call media stats \
	    -type f -name '*.h' -print0 \
	    | tar -cf - --null -T - \
	    | tar -xf - -C $(INSTALL_DIR)/usr/include/webrtc/
	cd $(SRC_DIR)/third_party/abseil-cpp && find absl -type f \
	    \( -name '*.h' -o -name '*.inc' \) -print0 \
	    | tar -cf - --null -T - \
	    | tar -xf - -C $(INSTALL_DIR)/usr/include/webrtc/
	@echo "Installed to $(INSTALL_DIR)"

# --------------------------------------------------------------------
# Headless transport-only verification demo (example/push_demo.cc)
#
# Consumes the INSTALLED package like the video module will: headers from
# install/root/usr/include/webrtc, libwebrtc.a + rlibs from install lib dir.
# Run "make install" first (auto-triggered if the archive is missing).
# --------------------------------------------------------------------
USR_INC   := $(INSTALL_DIR)/usr/include/webrtc
USR_LIB   := $(INSTALL_DIR)/usr/lib
RLIB_GLOB := $(wildcard $(USR_LIB)/webrtc_rlib/*.rlib)

demo:
	@test -f $(USR_LIB)/libwebrtc.a || { echo "ERROR: run 'make install' first"; exit 1; }
	@mkdir -p example/out
	$(CROSS_COMPILE)g++ -std=c++20 -O2 -fno-rtti -Wno-changes-meaning \
	    -DNDEBUG -DWEBRTC_POSIX -I$(USR_INC) \
	    example/push_demo.cc -o example/out/push_demo \
	    -Wl,--start-group $(USR_LIB)/libwebrtc.a $(RLIB_GLOB) -Wl,--end-group \
	    -Wl,--gc-sections -lpthread -ldl -lm
	$(CROSS_COMPILE)strip example/out/push_demo -o example/out/push_demo_stripped
	@ls -l example/out/push_demo example/out/push_demo_stripped | awk '{printf "%s: %.2f MB\n", $$NF, $$5/1048576}'

clean:
	rm -rf $(OUT_DIR) $(SRC_DIR)/ubuild_toolchain example/out

distclean: clean
	rm -rf $(INSTALL_DIR)

PKG:
	-rm -f $(PKG_NAME)
	cd install/root && tar Jcf ../../$(PKG_NAME) *

fetchPkg:
	$(call fetchPkgTemplate,$(PKG_NAME),install/root)

put-pkg:
	curl -u "${JFROG_USERNAME}:${JFROG_PASSWORD}" -T "${PKG_NAME}" "${JFROG_ARTIFACTORY_BASE_TAR}/${BOARD}/" --connect-timeout 10 --max-time 300

push-src:
	curl -u "${JFROG_USERNAME}:${JFROG_PASSWORD}" -T "${SRC_NAME}" "${JFROG_ARTIFACTORY_OPEN_SOURCE}/${BOARD}/" --connect-timeout 10 --max-time 300

# Copy the archive like other static libs (live555 pattern); smboot removes
# *.a from the assembled rootfs. Copy ONLY *.a - never the webrtc_rlib/
# directory: those 109MB Rust rlibs are build-host link inputs and their .rlib
# suffix is not covered by smboot's development-file cleanup.
crossInstall:
	mkdir -p $(CROSS_INSTALL_USR_LIB)
	cp -dfR install/root/usr/lib/*.a $(CROSS_INSTALL_USR_LIB)/

disFetchPkg:
	rm -rf install $(PKG_NAME)

disFetchSrc:
	rm -rf src

disFetchAll: disFetchSrc disFetchPkg

